{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "RELAYER_API_URL"
        },
        {
          "type": "service",
          "service": "ai",
          "format": "url",
          "env": "AI_GATEWAY_URL"
        }
      ]
    },
    "api": {
      "root": "services/application-api",
      "runtime": "node"
    },
    "ai": {
      "root": "services/ai-gateway",
      "runtime": "node"
    }
  },
  "rewrites": [
    {
      "source": "/api/relayer/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/ai/(.*)",
      "destination": {
        "service": "ai"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
